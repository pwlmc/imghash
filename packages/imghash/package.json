{
  "name": "imghash",
  "version": "2.0.0",
  "description": "Image perceptual hash calculation for node",
  "scripts": {
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "e2e": "bats e2e/*.bats",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwlmc/imghash.git"
  },
  "keywords": [
    "perceptual",
    "image",
    "hash",
    "phash",
    "imgseek"
  ],
  "author": "Paweł Maciejewski <pwlmaciejewski@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pwlmc/imghash/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/pwlmc/imghash#readme",
  "type": "module",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.10.1",
    "bats": "^1.13.0",
    "bats-assert": "^2.2.4",
    "bats-support": "^0.3.0",
    "leven": "^3.1.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@canvas/image": "^2.0.0",
    "blockhash-core": "^0.1.0",
    "image-type": "^4.1.0",
    "jpeg-js": "^0.4.1"
  }
}
